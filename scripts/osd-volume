#!/usr/bin/env bash
set -euo pipefail

action=${1:-}
step=${2:-5}

case "$action" in
up)
    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ "${step}%+"
    ;;
down)
    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${step}%-"
    ;;
mute)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    ;;
*)
    echo "Usage: ${0##*/} {up|down|mute} [step]" >&2
    exit 1
    ;;
esac

status=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
muted=false
if [[ "$status" == *"[MUTED]"* ]]; then
    muted=true
fi

level=$(awk '{ printf "%d", $2 * 100 }' <<<"$status")
if [[ "$muted" == true ]]; then
    icon="󰖁"
    title="Muted"
else
    title="Volume"
    if (( level < 33 )); then
        icon="󰕿"
    elif (( level < 67 )); then
        icon="󰖀"
    else
        icon="󰕾"
    fi
fi

qs ipc call osd show "$icon" "$title" "$level" >/dev/null 2>&1 || true
